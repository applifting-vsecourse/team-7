{
  "private": true,
  "license": "MIT",
  "scripts": {
    "backend": "pnpm --filter backend",
    "frontend": "pnpm --filter frontend",
    "env:check": "node scripts/check-env.js",
    "dev": "run-s env:check \"backend docker:up:wait\" \"backend migrate\" \"backend seed\" dev:servers",
    "dev:servers": "run-p \"backend start:dev\" \"frontend dev\"",
    "dev:down": "pnpm backend docker:down",
    "lint": "pnpm -r --stream run lint:check",
    "lint:fix": "pnpm -r --stream run lint:fix",
    "ts": "pnpm -r --stream run type-check",
    "check": "run-s lint ts",
    "check-all": "run-s lint \"backend test\" \"backend build\" \"frontend type-check\" \"frontend test:ci\" \"frontend build\" format:check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "dotenv-flow": "^4.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
