{
  "private": true,
  "license": "MIT",
  "scripts": {
    "backend": "pnpm --filter backend",
    "frontend": "pnpm --filter frontend",
    "env:check": "node scripts/check-env.js",
    "dev": "run-s env:check \"backend docker:up:wait\" \"backend migrate\" \"backend seed\" dev:servers",
    "dev:servers": "run-p \"backend start:dev\" \"frontend dev\"",
    "dev:down": "pnpm backend docker:down",
    "lint": "pnpm -r --stream run lint:check",
    "lint:fix": "pnpm -r --stream run lint:fix",
    "ts": "pnpm -r --stream run type-check",
    "check": "run-s lint ts",
    "check-all": "run-s lint ts test \"backend build\" \"frontend build\" format:check",
    "docs:heroui": "npx heroui-cli@latest agents-md --react --output HEROUI.md",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test --config apps/frontend/playwright.config.ts",
    "test:e2e:ui": "pnpm test:e2e --ui",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism --maxWorkers=1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tanstack/eslint-plugin-query": "5.106.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv-flow": "4.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.1.0",
    "vitest-mock-extended": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "postcss@<8.5.23": "8.5.32"
    }
  }
}
