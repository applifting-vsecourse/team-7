// Requires the Oxc extension (zed: extensions → Oxc).
{
  "languages": {
    "JavaScript": {
      "language_servers": ["oxlint", "oxfmt", "!biome", "!eslint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    },

