VITE_API_URL=http://localhost:4050/api
VITE_BETTER_AUTH_URL=http://localhost:4050
# To open the dev app from a phone on your LAN (http://<this-pc-ip>:3050), use
# the Vite dev proxy instead; it forwards /api to the backend:
# VITE_API_URL=/api
# VITE_BETTER_AUTH_URL=/
# Backend address for that proxy (default http://localhost:4050):
# VITE_DEV_API_TARGET=http://localhost:4050
