{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Trainloop backend — NestJS + Prisma + Postgres",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "prisma generate && nest build",
    "type-check": "prisma generate && tsc --noEmit --incremental false",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "start": "prisma generate && nest start --path tsconfig.dev.json --env-file .env",
    "start:dev": "prisma generate && nest start --path tsconfig.dev.json --env-file .env --watch --verbose",
    "start:debug": "prisma generate && nest start --path tsconfig.dev.json --env-file .env --debug --watch",
    "start:prod": "NODE_ENV=\"production\" node dist/main",
    "seed": "prisma generate && ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/seed/seed.script.ts",
    "migrate": "prisma migrate deploy",
    "start:migrate:prod": "prisma migrate deploy && npm run start:prod",
    "lint:check": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "pnpm --workspace-root test --project backend",
    "test:watch": "pnpm --workspace-root test:watch --project backend",
    "test:cov": "pnpm --workspace-root test:cov --project backend",
    "test:debug": "pnpm --workspace-root test:debug --project backend",
    "test:ci": "pnpm --workspace-root test:ci --project backend",
    "docker:up": "docker compose up",
    "docker:up:wait": "docker compose up -d --wait",
    "docker:up-rebuild": "docker compose down; docker compose up --renew-anon-volumes --build --force-recreate be",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrations:generate": "prisma migrate dev --create-only --name",
    "prisma:migrations:run": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "auth:generate": "npx @better-auth/cli generate --config ./src/shared/auth/utils/cli-auth-client.ts",
    "db:reset": "prisma migrate reset --force",
    "email:dev": "email dev --dir ./src/core/email/templates",
    "email:export": "email export --dir ./src/core/email/templates"
  },
  "dependencies": {
    "@applifting-io/nestjs-decorated-config": "1.0.8",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "nodemailer": "9.0.5",
    "prisma": "7.9.1",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-email": "6.11.6",
    "reflect-metadata": "0.2.2",
    "resend": "6.20.0",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.1",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
