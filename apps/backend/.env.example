# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword

# Google sign-in (optional; leave empty to disable)
# Google Cloud Console → OAuth client "Web application":
#   Authorized JavaScript origins: http://localhost:3050
#   Authorized redirect URIs: http://localhost:4050/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Environment Configuration
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050
# Optional comma-separated exact frontend origins (aliases or preview deployments).
# Allowed by CORS and BetterAuth; relative email callbacks still use FRONTEND_URL.
# Example: http://127.0.0.1:3050,https://preview.example.com
ADDITIONAL_FRONTEND_ORIGINS=

# Database Configuration
DATABASE_URL=postgresql://quacker:quacker@localhost:5433/quacker

# Server Configuration
PORT=4050

# Mail Configuration
# Resolution order (first match wins): Resend → SMTP → ConsoleMailerAdapter (dev logs).
# Set RESEND_API_KEY to use Resend.
RESEND_API_KEY=
EMAIL_FROM="TrainLoop <onboarding@resend.dev>"
# Development only: reroute all emails to this address. Forbidden in production.
EMAIL_REDIRECT_TO=
# Or set all three SMTP_* (HOST, USERNAME, PASSWORD) to use SMTP instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false (STARTTLS),
# SMTP_USERNAME=<the Gmail address, also the sender>, SMTP_PASSWORD=<app password, needs 2FA>.
# Port 587 because some hosts (e.g. Hetzner Cloud) block outgoing 465.
SMTP_HOST=
SMTP_SECURE=true
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional video storage. Create a PRIVATE bucket named exercise-videos.
# Never expose the secret API key to the frontend.
# Get an sb_secret_... key from Supabase Settings > API Keys.
# Project root URL: https://<project-ref>.supabase.co (no /rest/v1 or /storage/v1).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_VIDEO_BUCKET=exercise-videos
# Local development also needs ffmpeg and ffprobe on PATH (Docker includes them).
