# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword

# Google sign-in (optional; leave empty to disable)
# Google Cloud Console → OAuth client "Web application":
#   Authorized JavaScript origins: http://localhost:3050
#   Authorized redirect URIs: http://localhost:4050/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Environment Configuration
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050

# Database Configuration
DATABASE_URL=postgresql://quacker:quacker@localhost:5433/quacker

# Server Configuration
PORT=4050

# Mail Configuration
# Resolution order (first match wins): Resend → SMTP → ConsoleMailerAdapter (dev logs).
# Set RESEND_API_KEY to use Resend.
RESEND_API_KEY=
EMAIL_FROM="TrainLoop <onboarding@resend.dev>"
# Development only: send every email to this address (original recipient goes in the subject).
EMAIL_REDIRECT_TO=
# Or set all three SMTP_* (HOST, USERNAME, PASSWORD) to use SMTP instead.
SMTP_HOST=
SMTP_SECURE=true
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=