// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

// Set by the handler per dog; changing a goal never changes its exercises.
enum DogGoalStatus {
  in_progress
  paused
  completed

  @@map("dog_goal_status")
}

enum DogExerciseStatus {
  in_progress
  paused
  mastered

  @@map("dog_exercise_status")
}

model Dog {
  id            String    @id @default(cuid())
  name          String    @db.Text
  breed         String?
  birthDate     DateTime? @db.Date
  avatar        Bytes?
  avatarVersion String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  archivedAt    DateTime?
  scheduledExercises ScheduledExercise[]
  disciplines   DogDiscipline[]
  goals         DogGoal[]
  videos        Video[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@map("dog")
}

// The handler's library: discipline → goal → exercise. Dogs pick goals and
// exercises from it individually (DogGoal, DogExercise).
model Discipline {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  dogs        DogDiscipline[]
  goals       Goal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("discipline")
}

model Goal {
  id           String     @id @default(cuid())
  name         String
  // When the goal counts as achieved, e.g. "3 clean runs in a row".
  criterion    String?    @db.Text
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  disciplineId String
  exercises    Exercise[]
  dogs         DogGoal[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([disciplineId])
  @@map("goal")
}

model Exercise {
  id        String        @id @default(cuid())
  name      String
  procedure String?       @db.Text
  goal      Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    String
  // Display order within the goal, set by the handler. Purely visual: it
  // doesn't affect statuses, scheduling or which exercises are available.
  position  Int           @default(0)
  scheduledExercises ScheduledExercise[]
  dogs      DogExercise[]
  videos    Video[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  // Target for DogExercise's composite foreign key.
  @@unique([id, goalId])
  @@index([goalId, position])
  @@map("exercise")
}

enum VideoStatus {
  uploading
  pending
  processing
  completed
  failed
  deleting

  @@map("video_status")
}

// Keep jobs when their parent is deleted so the worker can remove bucket objects.
model Video {
  id           String         @id @default(cuid())
  // DB check restricts slots to 1..3; a partial unique index reserves each slot
  // per training session while status is not deleting (see video_sessions migration).
  slot         Int
  userId       String
  dogId        String?
  dog          Dog?           @relation(fields: [dogId], references: [id], onDelete: SetNull)
  exerciseId   String?
  exercise     Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sessionId    String?
  session      ScheduledExercise? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  filePath     String         @unique @map("file_path")
  outputPath   String         @unique @map("output_path")
  status       VideoStatus    @default(pending)
  rawDeletedAt DateTime?      @map("raw_deleted_at")
  duration     Float?
  error        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([dogId, exerciseId, createdAt])
  @@index([sessionId, createdAt])
  @@map("video")
}

model DogGoal {
  dog         Dog           @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId       String
  goal        Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      String
  status      DogGoalStatus @default(in_progress)
  // When the goal was last completed; null unless status is completed (DB check).
  completedAt DateTime?
  exercises   DogExercise[]
  createdAt   DateTime      @default(now())

  @@id([dogId, goalId])
  @@index([goalId])
  @@map("dog_goal")
}

// A dog can only train an exercise of a goal it has: the composite keys tie
// the row to the dog's DogGoal and to an exercise of that same goal.
model DogExercise {
  dogGoal    DogGoal  @relation(fields: [dogId, goalId], references: [dogId, goalId], onDelete: Cascade)
  dogId      String
  goalId     String
  exercise   Exercise @relation(fields: [exerciseId, goalId], references: [id, goalId], onDelete: Cascade)
  exerciseId String
  status     DogExerciseStatus @default(in_progress)
  createdAt  DateTime @default(now())

  @@id([dogId, exerciseId])
  @@index([exerciseId, goalId])
  @@map("dog_exercise")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean
  emailNotificationsEnabled Boolean @default(true)
  image         String?      @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  dogs          Dog[]
  disciplines   Discipline[]
  role          UserRole     @default(user)

  @@unique([email])
  @@map("user")
}

// Keeps a discipline assigned even before its first goal is created.
model DogDiscipline {
  dog          Dog        @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId        String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  disciplineId String
  createdAt    DateTime   @default(now())

  @@id([dogId, disciplineId])
  @@index([disciplineId])
  @@map("dog_discipline")
}

// A lesson with a trainer (#70) is a personal record: a dog and a time only,
// no exercise, rating or note. A database check keeps kind and exerciseId in step.
enum ScheduledExerciseKind {
  exercise
  lesson

  @@map("scheduled_exercise_kind")
}

model ScheduledExercise {
  videos Video[]
  id String @id @default(cuid())
  kind ScheduledExerciseKind @default(exercise)
  dogId String
  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  startsAt DateTime
  durationMinutes Int
  rating Int?
  note String? @db.Text
  completedAt DateTime?
  deletedAt DateTime?
  undoToken String?
  undoState Json?
  createdAt DateTime @default(now())

  @@index([dogId, startsAt])
  @@index([exerciseId])
  @@map("scheduled_exercise")
}
