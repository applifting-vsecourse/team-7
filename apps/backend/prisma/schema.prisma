// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

model Dog {
  id            String    @id @default(cuid())
  text          String    @db.Text
  avatar        Bytes?
  avatarVersion String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  goals         DogGoal[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@map("dog")
}

// The handler's library: discipline → goal → exercise. Dogs pick goals and
// exercises from it individually (DogGoal, DogExercise).
model Discipline {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  goals       Goal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("discipline")
}

model Goal {
  id           String     @id @default(cuid())
  name         String
  // When the goal counts as achieved, e.g. "3 clean runs in a row".
  criterion    String?    @db.Text
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  disciplineId String
  exercises    Exercise[]
  dogs         DogGoal[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([disciplineId])
  @@map("goal")
}

model Exercise {
  id        String        @id @default(cuid())
  name      String
  procedure String?       @db.Text
  goal      Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    String
  dogs      DogExercise[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  // Target for DogExercise's composite foreign key.
  @@unique([id, goalId])
  @@index([goalId])
  @@map("exercise")
}

model DogGoal {
  dog         Dog           @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId       String
  goal        Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      String
  // Set when the handler marks the goal achieved for this dog.
  completedAt DateTime?
  exercises   DogExercise[]
  createdAt   DateTime      @default(now())

  @@id([dogId, goalId])
  @@index([goalId])
  @@map("dog_goal")
}

// A dog can only train an exercise of a goal it has: the composite keys tie
// the row to the dog's DogGoal and to an exercise of that same goal.
model DogExercise {
  dogGoal    DogGoal  @relation(fields: [dogId, goalId], references: [dogId, goalId], onDelete: Cascade)
  dogId      String
  goalId     String
  exercise   Exercise @relation(fields: [exerciseId, goalId], references: [id, goalId], onDelete: Cascade)
  exerciseId String
  createdAt  DateTime @default(now())

  @@id([dogId, exerciseId])
  @@index([exerciseId, goalId])
  @@map("dog_exercise")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean
  image         String?      @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  dogs          Dog[]
  disciplines   Discipline[]
  role          UserRole     @default(user)

  @@unique([email])
  @@map("user")
}
